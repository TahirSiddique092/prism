# PRISM Frontend Environment Configuration
#
# In the hybrid deployment (ADR-015) the frontend runs in the local
# docker-compose stack and reaches the backend over the Docker network.
# docker-compose.yml already provides these — you normally don't set them here.
#
#   API_URL        server-side base URL to the Flask backend
#   COOKIE_SECURE  must be false over local http (so the auth cookie isn't dropped)
API_URL=http://backend:5000
COOKIE_SECURE=false
