# PRISM runs entirely locally via docker-compose. These are the defaults the
# compose file already uses, so `docker compose up` works with NO .env at all —
# copy this to `.env` only if you want to override something.

# --- Databases (docker-compose service hostnames) ---
MYSQL_URL=mysql+pymysql://user:password@mysql:3306/prism
POSTGRES_URL=postgresql://user:password@postgres:5432/prism
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=minio:9000                      # internal host (uploads/reads)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000    # browser host (signed view URLs)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- App ---
JWT_SECRET=your-secret-key                     # local dev only; fine as-is
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js container) ---
API_URL=http://backend:5000                    # server-side base URL to the backend
COOKIE_SECURE=false                            # local is http, so the cookie must not be Secure
