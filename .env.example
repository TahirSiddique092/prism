# PRISM hybrid deployment (ADR-015).
#
# Only the backend (Flask + the sentence-transformers model) and the frontend
# run locally in Docker; every stateful service is a managed free tier. Copy
# this to `.env` and fill in the connection strings from each provider's
# dashboard, then `docker compose up --build`.

# --- App ---
PRISM_ENV=production
CORS_STRICT=true
# Generate a strong secret, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-hex-secret
# Only the local app origin is trusted by CORS.
FRONTEND_URL=http://localhost:3000

# --- Postgres + pgvector (Neon) ---
POSTGRES_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require

# --- MySQL (Aiven) ---
MYSQL_URL=mysql+pymysql://USER:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED

# --- Neo4j (Aura) ---
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USER=XXXXXXXX
NEO4J_PASSWORD=your-aura-password

# --- Redis (Upstash; note the rediss:// TLS scheme) ---
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

# --- Object storage, S3-compatible (Neon Object Storage / Cloudflare R2 / etc.) ---
S3_ENDPOINT=https://HOST.storage.neon.tech
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=prism-documents
S3_REGION=us-east-1
# Only set S3_PUBLIC_ENDPOINT if the browser must reach storage at a different
# host than the backend does (not needed when S3_ENDPOINT is already public).
# S3_PUBLIC_ENDPOINT=
