# =============================================================================
# LOCAL DEVELOPMENT (docker-compose) — default values for `docker compose up`.
# =============================================================================
MYSQL_URL=mysql+pymysql://user:password@localhost:3306/prism
POSTGRES_URL=postgresql://user:password@localhost:5432/prism
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible). Locally this is MinIO; S3_* names are preferred
# and MINIO_* are kept as fallback. Remote endpoints default to https.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

JWT_SECRET=your-secret-key
NEXT_PUBLIC_API_URL=http://localhost:5000
FRONTEND_URL=https://prism.vercel.app

# =============================================================================
# PRODUCTION (Hugging Face Spaces + managed free tiers) — see
# deploy/huggingface-setup.md. Set these as Space secrets, NOT in a committed
# file. Shown here only as a reference of the expected variables.
# =============================================================================
# PRISM_ENV=production                 # enables startup fail-fast on weak JWT_SECRET
# CORS_STRICT=true                     # trust ONLY FRONTEND_URL / CORS_ALLOWED_ORIGINS
# JWT_SECRET=<32+ random chars>
# FRONTEND_URL=https://<your-project>.vercel.app
#
# MYSQL_URL=mysql+pymysql://<user>:<pass>@<aiven-host>:<port>/<db>
# POSTGRES_URL=postgresql://<user>:<pass>@<neon-host>/<db>?sslmode=require
# NEO4J_URI=neo4j+s://<auradb-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<auradb-password>
# REDIS_URL=rediss://<upstash-host>:<port>?password=<token>
#
# S3_ENDPOINT=https://br-<id>.storage.c-2.<region>.aws.neon.tech   # Neon Object Storage
# S3_ACCESS_KEY=<neon-credential-token_id>
# S3_SECRET_KEY=<neon-credential-s3_secret_access_key>
# S3_BUCKET=prism-documents
# S3_REGION=<neon-branch-region, e.g. us-east-2>
#
# Frontend (Vercel) only needs the API URL (server-only var preferred):
# API_URL=https://<user>-<space>.hf.space
# NEXT_PUBLIC_API_URL=https://<user>-<space>.hf.space
